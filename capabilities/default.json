{
  "identifier": "default",
  "description": "allow custom commands",
  "windows": [
    "main",
    "splash"
  ],
  "webviews": [
    "main",
    "splash"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
	"core:default",
	"dialog:default",
	"notification:default",
    "window-state:default",
	"allow-window-minimize",
    "allow-window-hide",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-start-dragging",
    "allow-window-is-maximized",
    "allow-retry-backend-connection",
    "allow-save-as",
    "allow-download-today-gui-log",
    "allow-download-today-launcher-log"
  ]
}
